{
  "name": "CommunityReply",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "upvotes": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "post_id",
    "content",
    "author_name",
    "author_email"
  ]
}